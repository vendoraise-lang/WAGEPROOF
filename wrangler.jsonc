{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "proposal-preflight",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [{ "binding": "FACTORY", "service": "business-factory", "entrypoint": "Analytics" }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "PAYMENT_PROVIDER": "lemonsqueezy", "LEMON_TEST_INTEGRATION_APPROVED": "true", "FREE_BETA": "true", "PAYMENT_MODE": "test", "LIVE_PAYMENTS_APPROVED": "false", "BUSINESS_JURISDICTION": "Morocco", "TARGET_MARKET": "US" }
}
