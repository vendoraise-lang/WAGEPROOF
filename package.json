{
  "name": "proposal-preflight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check checker.js && node --check worker.js && node --check public/app.js",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "4.149.0"
  }
}
