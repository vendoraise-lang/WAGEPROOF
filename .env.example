# Load securely through your hosting provider. Local: node --env-file=.env server.js
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Generate privately: openssl rand -hex 32. Keep stable across redeployments.
APP_SECRET=
# Only enable behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
